# Copy to .env and fill in real values. NEVER commit .env.

# Supabase PostgreSQL (use the Session pooler host)
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-db-password

# JWT (long random string, 48+ chars)
JWT_SECRET=change-me

# Gmail SMTP - primary
GMAIL_USERNAME=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_FROM=you@gmail.com

# Brevo SMTP - fallback
BREVO_SMTP_USERNAME=your-brevo-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_FROM=verified-sender@example.com

# Frontend URL allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173
